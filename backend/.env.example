# ─── Shopify App Credentials ─────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_hex_here

# Scopes required by the app
SCOPES=read_products,read_orders,write_orders

# The public URL where this app is hosted (no trailing slash)
APP_URL=https://your-app.vercel.app

# ─── Database (MySQL / Aiven) ─────────────────────────────────────────────────
DB_HOST=your-db-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_db_password_here
DB_NAME=defaultdb

# SSL certificate for the DB connection. Use ONE of:
#   DB_SSL    — path to a CA .pem file (good for local dev)
#   DB_SSL_CA — the CA certificate contents inline (good for cloud hosts
#               like Render where you can't commit a file)
DB_SSL=ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ML Service
ML_SERVICE_URL=http://localhost:8000
